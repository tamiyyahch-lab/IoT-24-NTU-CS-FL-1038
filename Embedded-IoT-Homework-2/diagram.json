{
  "version": 1,
  "author": "Embedded-IoT-Homework-2",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -100, "left": 230, "attrs": { "color": "red" } },
    { "type": "wokwi-led", "id": "led2", "top": -100, "left": 310, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -20, "left": 195, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": -20, "left": 275, "rotate": 90, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:18", "r1:1", "green", [ "h0" ] ],
    [ "r1:2", "led1:A", "green", [ "h0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v0" ] ],

    [ "esp:19", "r2:1", "green", [ "h0" ] ],
    [ "r2:2", "led2:A", "green", [ "h0" ] ],
    [ "led2:C", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}